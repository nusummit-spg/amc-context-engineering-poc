:begin
CREATE RANGE INDEX FOR (n:Document) ON (n.document_id);
CREATE RANGE INDEX FOR (n:Entity) ON (n.label);
CREATE RANGE INDEX FOR (n:TaxonomyNode) ON (n.path);
CREATE CONSTRAINT analyst_name FOR (node:Analyst) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT clausetype_name FOR (node:ClauseType) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT document_name FOR (node:Document) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT entity_key FOR (node:Entity) REQUIRE (node.dedup_key) IS UNIQUE;
CREATE CONSTRAINT issuer_name FOR (node:Issuer) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT issuergroup_name FOR (node:IssuerGroup) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT regulatorycircular_name FOR (node:RegulatoryCircular) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT risktheme_name FOR (node:RiskTheme) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT scheme_name FOR (node:Scheme) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT sector_name FOR (node:Sector) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT taxonomynode_name FOR (node:TaxonomyNode) REQUIRE (node.name) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
