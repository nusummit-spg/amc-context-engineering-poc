# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets & local config
.env
backend/.env
streamlit_app/.env
docker-compose.override.yml

# Data (uploads, corpus, model caches)
data/
backend/data/
.cache/

# ...except the small taxonomy definition JSON, which is source (needed to
# rebuild the taxonomy_engine Neo4j graph) and small enough to track.
!streamlit_app/data/
streamlit_app/data/*
!streamlit_app/data/taxonomy/
streamlit_app/data/taxonomy/*
!streamlit_app/data/taxonomy/mutual_fund_taxonomy_v0_3.json

# Runtime logs / local-run artifacts (query audit trails, chat session
# transcripts, judge_eval reports) — generated by running the app, not source.
streamlit_app/logs/

# IDE
.idea/
.vscode/
.claude/
/streamlit_app.backup/
