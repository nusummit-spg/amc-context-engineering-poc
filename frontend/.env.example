# Base URL of the ContextGraph FastAPI backend (see backend/app/main.py — routes
# are mounted under /api). No trailing slash.
#
# Local dev (uvicorn or docker compose):
VITE_API_BASE_URL=http://localhost:8000/api

# Pointed at an AWS deployment instead:
# VITE_API_BASE_URL=https://api.your-domain.com/api
